<?xml version="1.0"?>
<!-- cwu_nav의 ROS 2 패키지 정보와 실행 의존성을 선언합니다.
     미션 1 상태머신과 400 mm 격자 플래너(보드의 이산 이동 [F]·[TL/TR] 명령)를 제공합니다. -->
<package format="3">
  <name>cwu_nav</name>
  <version>0.1.0</version>
  <description>Mission 1 state machine and grid-cell planner for the 3.6 m arena, driving the base through discrete turn/straight board commands.</description>
  <maintainer email="maintainer@example.com">CWU Robot Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cwu_slam</exec_depend>
  <exec_depend>cwu_base</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- mission1: 상태머신 -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cwu_perception</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
