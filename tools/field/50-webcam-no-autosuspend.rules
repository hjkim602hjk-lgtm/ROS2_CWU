# Robot webcam (Microdia 0c45:636b): USB autosuspend makes it fail to resume (-110) -> camera hangs.
# delay -1 = never autosuspend, even if uvcvideo re-enables runtime PM (control=auto) after this rule at boot.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0c45", ATTR{idProduct}=="636b", ATTR{power/autosuspend_delay_ms}="-1", ATTR{power/control}="on"
